{
  "expo": {
    "name": "Prisma",
    "slug": "prisma",
    "owner": "deywd",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prisma",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0a0c"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.prisma.app",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Permita o reconhecimento de voz para transcrever suas mensagens.",
        "NSMicrophoneUsageDescription": "Permita o microfone para ditar mensagens ao assistente."
      }
    },
    "android": {
      "package": "com.prisma.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0a0c"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Permita o Face ID para proteger o acesso aos seus dados."
        }
      ],
      "expo-notifications",
      [
        "expo-calendar",
        {
          "calendarPermission": "Permita acessar a agenda para importar suas escalas."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Permita o microfone para ditar mensagens ao assistente.",
          "speechRecognitionPermission": "Permita o reconhecimento de voz para transcrever suas mensagens.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permita acessar suas fotos para escolher a imagem do contato.",
          "cameraPermission": "Permita usar a câmera para fotografar o contato."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3f0aa034-693f-47af-8fc1-8125fd5dc423"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3f0aa034-693f-47af-8fc1-8125fd5dc423"
    }
  }
}
